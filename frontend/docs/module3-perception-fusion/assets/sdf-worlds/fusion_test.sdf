<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="fusion_test_world">
    <!-- Include standard Gazebo components -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Robot with multiple sensors for fusion testing -->
    <model name="fusion_test_robot">
      <pose>0 0 0.5 0 0 0</pose>

      <!-- Robot base -->
      <link name="base_link">
        <inertial>
          <mass>10.0</mass>
          <inertia>
            <ixx>0.1</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.1</iyy>
            <iyz>0.0</iyz>
            <izz>0.1</izz>
          </inertia>
        </inertial>

        <visual name="base_visual">
          <geometry>
            <box>
              <size>0.5 0.3 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.8 1.0</ambient>
            <diffuse>0.3 0.3 1.0 1.0</diffuse>
          </material>
        </visual>

        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.5 0.3 0.3</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- Head with sensor suite -->
      <link name="head">
        <pose>0.2 0 0.1 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.01</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.01</iyy>
            <iyz>0.0</iyz>
            <izz>0.01</izz>
          </inertia>
        </inertial>

        <visual name="head_visual">
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1.0</ambient>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
          </material>
        </visual>

        <collision name="head_collision">
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
        </collision>
      </link>

      <joint name="head_joint" type="fixed">
        <parent>base_link</parent>
        <child>head</child>
        <pose>0.2 0 0.1 0 0 0</pose>
      </joint>

      <!-- Camera Mount -->
      <link name="camera_mount">
        <pose>0.25 0 0.1 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.0001</iyy>
            <iyz>0.0</iyz>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
      </link>

      <joint name="camera_mount_joint" type="fixed">
        <parent>head</parent>
        <child>camera_mount</child>
        <pose>0.05 0 0 0 0 0</pose>
      </joint>

      <!-- IMU Mount -->
      <link name="imu_mount">
        <pose>0.2 0 0.15 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.00001</iyy>
            <iyz>0.0</iyz>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
      </link>

      <joint name="imu_mount_joint" type="fixed">
        <parent>head</parent>
        <child>imu_mount</child>
        <pose>0 0 0.05 0 0 0</pose>
      </joint>

      <!-- LiDAR Mount -->
      <link name="lidar_mount">
        <pose>0.3 0 0.1 0 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.001</iyy>
            <iyz>0.0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
      </link>

      <joint name="lidar_mount_joint" type="fixed">
        <parent>head</parent>
        <child>lidar_mount</child>
        <pose>0.1 0 0 0 0 0</pose>
      </joint>

      <!-- RGB Camera Sensor -->
      <gazebo reference="camera_mount">
        <sensor name="rgb_camera" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <camera name="head_camera">
            <horizontal_fov>1.047</horizontal_fov> <!-- 60 degrees -->
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>camera</namespace>
              <remapping>~/image_raw:=image</remapping>
              <remapping>~/camera_info:=camera_info</remapping>
            </ros>
            <camera_name>rgb_camera</camera_name>
            <image_topic_name>image</image_topic_name>
            <camera_info_topic_name>camera_info</camera_info_topic_name>
            <frame_name>camera_mount</frame_name>
            <update_rate>30</update_rate>
          </plugin>
        </sensor>
      </gazebo>

      <!-- Depth Camera Sensor -->
      <gazebo reference="camera_mount">
        <sensor name="depth_camera" type="depth">
          <pose>0.01 0 0 0 0 0</pose>
          <camera name="head_depth_camera">
            <horizontal_fov>1.047</horizontal_fov> <!-- 60 degrees -->
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10.0</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </camera>
          <plugin name="depth_camera_controller" filename="libgazebo_ros_openni_kinect.so">
            <ros>
              <namespace>depth_camera</namespace>
              <remapping>~/rgb/image_raw:=rgb/image</remapping>
              <remapping>~/depth/image_raw:=depth/image</remapping>
              <remapping>~/rgb/camera_info:=rgb/camera_info</remapping>
            </ros>
            <camera_name>depth_camera</camera_name>
            <image_topic_name>rgb/image</image_topic_name>
            <depth_image_topic_name>depth/image</depth_image_topic_name>
            <point_cloud_topic_name>points</point_cloud_topic_name>
            <frame_name>camera_mount</frame_name>
            <update_rate>30</update_rate>
          </plugin>
        </sensor>
      </gazebo>

      <!-- IMU Sensor -->
      <gazebo reference="imu_mount">
        <sensor name="imu_sensor" type="imu">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <pose>0 0 0 0 0 0</pose>
          <imu>
            <angular_velocity>
              <x>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.02</stddev>
                  <bias_mean>0.0</bias_mean>
                  <bias_stddev>0.005</bias_stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.02</stddev>
                  <bias_mean>0.0</bias_mean>
                  <bias_stddev>0.005</bias_stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>0.02</stddev>
                  <bias_mean>0.0</bias_mean>
                  <bias_stddev>0.005</bias_stddev>
                </noise>
              </z>
            </angular_velocity>
            <linear_acceleration>
              <x>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>1.7e-2</stddev>
                  <bias_mean>0.0</bias_mean>
                  <bias_stddev>0.5e-3</bias_stddev>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>1.7e-2</stddev>
                  <bias_mean>0.0</bias_mean>
                  <bias_stddev>0.5e-3</bias_stddev>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0.0</mean>
                  <stddev>1.7e-2</stddev>
                  <bias_mean>0.0</bias_mean>
                  <bias_stddev>0.5e-3</bias_stddev>
                </noise>
              </z>
            </linear_acceleration>
          </imu>
          <plugin name="imu_controller" filename="libgazebo_ros_imu.so">
            <ros>
              <namespace>imu</namespace>
              <remapping>~/out:=data</remapping>
            </ros>
            <frame_name>imu_mount</frame_name>
            <topic>data</topic>
            <update_rate>100</update_rate>
          </plugin>
        </sensor>
      </gazebo>

      <!-- 2D LiDAR Sensor -->
      <gazebo reference="lidar_mount">
        <sensor name="lidar_2d" type="ray">
          <pose>0 0 0 0 0 0</pose>
          <ray>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1.0</resolution>
                <min_angle>-3.14159</min_angle> <!-- -π radians -->
                <max_angle>3.14159</max_angle>  <!-- π radians -->
              </horizontal>
            </scan>
            <range>
              <min>0.1</min>
              <max>30.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
          <plugin name="lidar_2d_controller" filename="libgazebo_ros_laser.so">
            <ros>
              <namespace>lidar_2d</namespace>
              <remapping>~/out:=scan</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>lidar_mount</frame_name>
            <topic>scan</topic>
            <update_rate>10</update_rate>
          </plugin>
        </sensor>
      </gazebo>

      <!-- Additional 3D LiDAR Sensor -->
      <gazebo reference="lidar_mount">
        <sensor name="lidar_3d" type="ray">
          <pose>0.01 0 0 0 0 0</pose>
          <ray>
            <scan>
              <horizontal>
                <samples>1080</samples>
                <resolution>1.0</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>16</samples>
                <resolution>0.2618</resolution> <!-- 15 degrees between beams -->
                <min_angle>-0.2618</min_angle>  <!-- -15 degrees -->
                <max_angle>0.2618</max_angle>   <!-- 15 degrees -->
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>100.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
          <plugin name="lidar_3d_controller" filename="libgazebo_ros_velodyne_gpu_laser.so">
            <ros>
              <namespace>lidar_3d</namespace>
              <remapping>~/out:=points</remapping>
            </ros>
            <output_type>sensor_msgs/PointCloud2</output_type>
            <frame_name>lidar_mount</frame_name>
            <topic>points</topic>
            <update_rate>10</update_rate>
          </plugin>
        </sensor>
      </gazebo>
    </model>

    <!-- Simple environment for fusion testing -->
    <model name="test_obstacle_1">
      <pose>-2 1 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.1</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.1</iyy>
            <iyz>0.0</iyz>
            <izz>0.1</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.5 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.3 0.3 1.0</ambient>
            <diffuse>1.0 0.4 0.4 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 0.5 1.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="test_obstacle_2">
      <pose>2 -1 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.1</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.1</iyy>
            <iyz>0.0</iyz>
            <izz>0.1</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.8 0.3 1.0</ambient>
            <diffuse>0.4 1.0 0.4 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="test_obstacle_3">
      <pose>0 3 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.1</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.1</iyy>
            <iyz>0.0</iyz>
            <izz>0.1</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.4</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.8 1.0</ambient>
            <diffuse>0.4 0.4 1.0 1.0</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.4</radius>
            </sphere>
          </geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>